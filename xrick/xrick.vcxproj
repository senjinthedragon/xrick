  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <!-- static CRT: the default (dynamic, /MD) needs the VC++ Redistributable
           installed on the player's machine, fine on a dev box (Visual Studio
           puts it there), not on a clean Windows install, which is exactly why
           this went unnoticed until actually tested in a real VM (2026-10-12):
           "VCRUNTIME140.dll was not found." SDL3 stays a separate .dll either
           way (vcpkg's x64-windows triplet), so this only affects our own
           compiled code, not a CRT-mismatch link against it. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <!-- Windows (GUI) subsystem + mainCRTStartup: xrick.c's setConsole() only ever
           calls AttachConsole() to reuse an EXISTING parent console (when launched
           from a terminal) -- it never creates one. The actual console window
           players were seeing (reported 2026-10-12, "I don't like") came from the
           Console subsystem itself: Windows always auto-creates a new console for
           a Console-subsystem exe that has no parent one, i.e. every normal
           double-click from Explorer. SDL_MAIN_HANDLED (above) means the real
           entry point is xrick.c's own main(), not WinMain -- EntryPointSymbol
           tells the linker to use the console CRT startup stub that calls main()
           even though the declared subsystem is Windows, so no WinMain is needed. -->
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>mainCRTStartup</EntryPointSymbol>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
