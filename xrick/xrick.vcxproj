  <!-- T21: bin\<Configuration>\ instead of the default $(Platform)\$(Configuration)\
       (x64\Release\ etc): there's only one platform now, so the platform segment
       was pure noise. IntDir keeps the old default shape so object files from a
       stale Win32 build (if any) can't collide with these. -->
  <PropertyGroup>
    <OutDir>$(ProjectDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <!-- T19 native-build fix: common settings shared by both configs, merged with
       %(...) so the per-config blocks below can still add their own. Previously only
       Debug|Win32 set AdditionalIncludeDirectories/PreprocessorDefinitions at all,
       so the other configs had no path to include\*.h, which is why they could
       never compile. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- T20: source now includes <SDL3/SDL.h> (not bare <SDL.h>), so unlike the
           SDL2 port, no extra ...\include\SDL3 entry is needed: vcpkg's sdl3
           port already places headers under include\SDL3\ within this path. -->
      <AdditionalIncludeDirectories>include;include\rd1;include\rd2;src;src\rd1;src\rd2;vcpkg_installed\$(VcpkgTriplet)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- SDL_MAIN_HANDLED: SDL_main.h renames main() to SDL_main() on Windows unless
           told otherwise, which otherwise leaves xrick.c's own main() with no real
           main symbol to link against (found via LNK2001 on the first native build,
           2026-09-10). The Linux/Makefile build never hits this since SDL_main.h's
           renaming is Windows/WinRT/iOS/Android-only. -->
      <!-- 2.0.0: WIN32 was missing here, so system.h's own __WIN32__ convention was dead
           on this project the whole time: silently disabled xrick.c's AttachConsole
           console-reattach code, and would have broken menu.c's new MSVC execvp shim. -->
      <PreprocessorDefinitions>WIN32;_MBCS;_CRT_SECURE_NO_WARNINGS;SDL_MAIN_HANDLED;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>vcpkg_installed\$(VcpkgTriplet)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>SDL3.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <!-- T19 native-build fix: SDL2.dll [T20: SDL3.dll] is vcpkg's dynamic-triplet
         runtime dep and doesn't get auto-deployed here (that needs VcpkgEnabled's
         own targets import, which this project doesn't pull in), so copy it next to
         the exe explicitly on every build. T22: zlib/z.dll dropped, see build.md;
         nothing in the tree calls into it any more. -->
    <PostBuildEvent>
      <Command>copy /Y "$(ProjectDir)vcpkg_installed\$(VcpkgTriplet)\bin\SDL3.dll" "$(OutDir)" &gt;nul</Command>
    </PostBuildEvent>
    <!-- 2.0.0: this project was never updated for the fork's SDL_GPU renderer work and
         built only upstream's plain-OpenGL RD1+RD2 tree (no menu/carousel/bezels/CRT).
         shaders_embedded.c's #embed directives (see that file) need these .spv files
         to exist before it compiles, mirroring the Makefile's $(SHADER_BUILD) step;
         assumes glslc (shaderc) is on PATH, same assumption the Makefile makes via
         its GLSLC variable.
         MSVC does not implement #embed at all yet, even with the documented
         /std:clatest /Zc:preprocessor flags (confirmed against a real build: C1021
         "invalid preprocessor command 'embed'"). tools\gen_embed.py is a stand-in:
         it generates the same byte-array definitions from a plain Python script, so
         generated\*_embedded.c (added below, replacing the #embed sources for this
         project only) link against the exact same symbols shaders_embedded.h etc.
         declare. Needs python on PATH. -->
    <PreBuildEvent>
      <Command>if not exist "$(ProjectDir)..\build\shaders" mkdir "$(ProjectDir)..\build\shaders"
for %%f in ("$(ProjectDir)src\shaders\gpu\*.vert") do glslc -fshader-stage=vert "%%f" -o "$(ProjectDir)..\build\shaders\%%~nxf.spv"
for %%f in ("$(ProjectDir)src\shaders\gpu\*.frag") do glslc -fshader-stage=frag "%%f" -o "$(ProjectDir)..\build\shaders\%%~nxf.spv"
if not exist "$(ProjectDir)generated" mkdir "$(ProjectDir)generated"
python "$(ProjectDir)tools\gen_embed.py" "$(ProjectDir)generated\shaders_embedded.c" shaders_embedded.h shader_passthrough_vert_spv="$(ProjectDir)..\build\shaders\passthrough.vert.spv" shader_passthrough_frag_spv="$(ProjectDir)..\build\shaders\passthrough.frag.spv" shader_sharp_bilinear_frag_spv="$(ProjectDir)..\build\shaders\sharp-bilinear.frag.spv" shader_crt_lottes_frag_spv="$(ProjectDir)..\build\shaders\crt-lottes.frag.spv" shader_crt_easymode_frag_spv="$(ProjectDir)..\build\shaders\crt-easymode.frag.spv" shader_fsr_easu_frag_spv="$(ProjectDir)..\build\shaders\fsr-easu.frag.spv" shader_fsr_rcas_frag_spv="$(ProjectDir)..\build\shaders\fsr-rcas.frag.spv" shader_crt_easymode_post_frag_spv="$(ProjectDir)..\build\shaders\crt-easymode-post.frag.spv" shader_crt_royale_linearize_frag_spv="$(ProjectDir)..\build\shaders\crt-royale-linearize.frag.spv" shader_crt_royale_vscan_frag_spv="$(ProjectDir)..\build\shaders\crt-royale-vscan.frag.spv" shader_crt_royale_bloom_approx_frag_spv="$(ProjectDir)..\build\shaders\crt-royale-bloom-approx.frag.spv" shader_crt_royale_hscan_mask_frag_spv="$(ProjectDir)..\build\shaders\crt-royale-hscan-mask.frag.spv" shader_crt_royale_brightpass_frag_spv="$(ProjectDir)..\build\shaders\crt-royale-brightpass.frag.spv" shader_crt_royale_bloom_blur_frag_spv="$(ProjectDir)..\build\shaders\crt-royale-bloom-blur.frag.spv" shader_crt_royale_reconstitute_frag_spv="$(ProjectDir)..\build\shaders\crt-royale-reconstitute.frag.spv" shader_crt_curvature_frag_spv="$(ProjectDir)..\build\shaders\crt-curvature.frag.spv" shader_crt_final_encode_frag_spv="$(ProjectDir)..\build\shaders\crt-final-encode.frag.spv"
python "$(ProjectDir)tools\gen_embed.py" "$(ProjectDir)generated\bezels_embedded.c" bezels_embedded.h bezel_commodore_1084s_png="$(ProjectDir)src\bezels\commodore_1084s.png" bezel_atari_sc1224_png="$(ProjectDir)src\bezels\atari_sc1224.png"
python "$(ProjectDir)tools\gen_embed.py" "$(ProjectDir)generated\masks_embedded.c" masks_embedded.h mask_phosphor_slot_mip0_png="$(ProjectDir)src\masks\phosphor_mask_slot_mip0.png" mask_phosphor_slot_mip1_png="$(ProjectDir)src\masks\phosphor_mask_slot_mip1.png" mask_phosphor_slot_mip2_png="$(ProjectDir)src\masks\phosphor_mask_slot_mip2.png" mask_phosphor_slot_mip3_png="$(ProjectDir)src\masks\phosphor_mask_slot_mip3.png" mask_phosphor_slot_mip4_png="$(ProjectDir)src\masks\phosphor_mask_slot_mip4.png"
python "$(ProjectDir)tools\gen_embed.py" "$(ProjectDir)generated\gameselect_embedded.c" gameselect_embedded.h gameselect_rd2_label_png="$(ProjectDir)src\gameselect\rd2_label.png" gameselect_disk_body_png="$(ProjectDir)src\gameselect\disk_body.png"</Command>
    </PreBuildEvent>
