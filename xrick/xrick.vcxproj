  <!-- T21 (2026-09-10): defaults for a bare `MSBuild xrick.vcxproj` with no
       /p:Configuration or /p:Platform: Release/x64 rather than MSBuild's own
       Debug/Win32 fallback. Must be set before Microsoft.Cpp.Default.props, which
       is what actually consumes $(Platform) to pick a default toolset.
       Note: XML comments can't contain two adjacent dashes, so a dash pair
       elsewhere in this file is written as "- " or ":" instead. -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
  </PropertyGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{FD11A8D7-90E4-475D-835C-0410965E4BC5}</ProjectGuid>
    <RootNamespace>xrick</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- T19 native-build fix (2026-09-10): SDL2/zlib now come from vcpkg (vcpkg.json
         manifest in this directory), not the ..\..\lib\SDL2-2.0.9 / zlib1211 paths
         this project used to expect and which were never present in the repo.
         T20 (2026-09-10): SDL2 -> SDL3, matching the Makefile/WSL build, see
         build.md.
         T21 (2026-09-10): dropped the Win32/x86 configs, x64 only from here on, so
         VcpkgTriplet no longer needs a per-platform condition. -->
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgTriplet>x64-windows</VcpkgTriplet>
  </PropertyGroup>
